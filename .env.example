# Copiez ce fichier en `.env.local` puis complétez les valeurs.

# Postgres : `docker compose up -d` démarre une base locale sur le port 5433.
# Sur Vercel, l'intégration Neon renseigne cette variable automatiquement.
DATABASE_URL=postgres://papertrade:papertrade@localhost:5433/papertrade

# Secret de signature des sessions : `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# URL publique de l'application (inutile sur Vercel, déduite automatiquement)
BETTER_AUTH_URL=http://localhost:3000

# Optionnel : connexion avec GitHub (https://github.com/settings/developers)
# Callback URL : <BETTER_AUTH_URL>/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Protège la tâche planifiée de nettoyage des comptes invités : `openssl rand -hex 16`
CRON_SECRET=
